PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/bookhaven
SESSION_SECRET=change_me_to_a_long_random_string

# Origins allowed to call the API when the frontend is served from another port (e.g. VS Code Live Server)
CLIENT_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5000,http://127.0.0.1:5000

# Pricing rules (all calculated on the server)
FREE_SHIPPING_THRESHOLD=499
SHIPPING_FEE=49
TAX_RATE=0.05
MAX_ITEM_QUANTITY=10
